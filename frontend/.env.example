# Copy to .env (local) or set in Vercel/Netlify project settings.

# Backend URL. Leave empty in local dev (Vite proxies /api to http://127.0.0.1:8000).
# Production example: https://snaptable-api.onrender.com
VITE_API_URL=

# "Report an issue" form — the destination inbox is never shown on the page.
# Option 1 (recommended): a Web3Forms access key (free, 250 submissions/month).
#   Create it at https://web3forms.com with your support inbox; the key is bound to that address.
VITE_WEB3FORMS_KEY=
# Option 2 (fallback when no key): the form opens the visitor's mail app addressed to this inbox.
VITE_SUPPORT_EMAIL=
